<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-authored: Kinova ships no parametrized SRDF xacro (unlike the arm's
URDF). The "ready" pose below matches kortex_moveit_config's own gen3.srdf
"Vertical" group state (all zeros) for the gen3_7dof variant
(kortex_moveit_config/kinova_gen3_7dof_robotiq_2f_85_moveit_config/config/gen3.srdf).
This project builds the arm with no gripper (see env/config.py::GEN3_XACRO_ARGS).
-->
<robot name="gen3">
    <group name="manipulator">
        <chain base_link="base_link" tip_link="end_effector_link"/>
    </group>
    <group_state name="ready" group="manipulator">
        <joint name="joint_1" value="0" />
        <joint name="joint_2" value="0" />
        <joint name="joint_3" value="0" />
        <joint name="joint_4" value="0" />
        <joint name="joint_5" value="0" />
        <joint name="joint_6" value="0" />
        <joint name="joint_7" value="0" />
    </group_state>
</robot>
