<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-authored: Kinova ships no parametrized SRDF xacro (unlike the arm's
URDF). The "ready" pose below is a bent working configuration for the
gen3_7dof + robotiq_2f_85 variant (values as requested; note joint_2/joint_4/
joint_6 differ slightly from kortex_moveit_config's own "Home" group state
for the same variant).
-->
<robot name="gen3">
    <group name="manipulator">
        <chain base_link="base_link" tip_link="end_effector_link"/>
    </group>
    <group name="gripper">
        <joint name="robotiq_85_left_knuckle_joint"/>
    </group>
    <group_state name="ready" group="manipulator">
        <joint name="joint_1" value="0" />
        <joint name="joint_2" value="0.1920" />
        <joint name="joint_3" value="3.14" />
        <joint name="joint_4" value="-1.4312" />
        <joint name="joint_5" value="0" />
        <joint name="joint_6" value="-1.5184" />
        <joint name="joint_7" value="1.5708" />
    </group_state>
    <group_state name="Open" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0"/>
    </group_state>
    <group_state name="Close" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.8"/>
    </group_state>
    <end_effector name="gripper" parent_link="end_effector_link" group="gripper"/>
</robot>
